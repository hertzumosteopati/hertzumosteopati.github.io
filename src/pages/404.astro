---
// One bilingual 404: Danish first, then English. GitHub Pages serves dist/404.html for unknown paths.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { getPage } from '../lib/content';
import { routes } from '../i18n/utils';

const da = await getPage('da', '404');
const en = await getPage('en', '404');
const { Content: DaText } = await render(da);
const { Content: EnText } = await render(en);
---

<Base title={da.data.title} description={da.data.description} lang="da" paths={routes.home} noindex>
  <section class="section notfound">
    <div class="container notfound__grid">
      <div class="notfound__block">
        <Eyebrow as="p">404</Eyebrow>
        <h1 class="display-l">{da.data.headline}</h1>
        <div class="body measure"><DaText /></div>
        <div class="actions"><Button href={routes.home.da} icon="arrow" lang="da">{da.data.labels.cta}</Button></div>
      </div>
      <div class="notfound__block" lang="en">
        <h2 class="display-m">{en.data.headline}</h2>
        <div class="body measure"><EnText /></div>
        <div class="actions"><Button href={routes.home.en} variant="outline" icon="arrow" lang="en">{en.data.labels.cta}</Button></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound { padding-top: var(--space-9); }
  .notfound__grid { display: grid; gap: var(--space-8); }
  .notfound__block { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); }
  @media (max-width: 699px) { .notfound { padding-top: var(--space-7); } .notfound__grid { gap: var(--space-7); } }
</style>

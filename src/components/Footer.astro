---
import { clinics, site, EASYME_URL } from '../data/site';
import { getSection } from '../lib/content';
import { t, other, type Lang } from '../i18n/utils';
interface Props {
  lang: Lang;
  alternate: string;
}
const { lang, alternate } = Astro.props;
const s = t(lang);
const f = (await getSection(lang, 'footer')).data.labels;
const year = new Date().getFullYear();
const otherLang = other(lang);
---

<footer class="site-footer">
  <div class="site-footer__band">
    <div class="container site-footer__grid">
      {Object.values(clinics).map((c) => (
        <div>
          <p class="site-footer__title">{c.town}</p>
          <p class="meta-text site-footer__text">{c.name}<br />{c.street}<br />{c.postalCode} {c.town}</p>
        </div>
      ))}
      <div>
        <p class="site-footer__title">{f.bookingTitle}</p>
        <ul class="site-footer__links meta-text">
          <li><a href={EASYME_URL} target="_blank" rel="noopener">{f.online}<span class="ho-visually-hidden"> {s.newTab}</span></a></li>
          <li><a href={clinics.nykobing.phoneHref}>{f.phone}</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="container site-footer__line">
    <p>© {year} {site.name} · CVR {site.cvr}</p>
    <p>{f.languageLine}</p>
    <p><a href={alternate} lang={otherLang} hreflang={otherLang}>{s.switchLabel}</a></p>
  </div>
</footer>

<style>
  .site-footer__band { background: var(--sand); padding-block: var(--space-8); }
  .site-footer__grid { display: grid; gap: var(--space-6); grid-template-columns: repeat(3, 1fr); }
  .site-footer__title {
    margin-bottom: var(--space-2);
    font-family: var(--font-display); font-size: 17px; line-height: 1.3; font-weight: 600; font-variation-settings: "opsz" 18;
  }
  .site-footer__text { color: var(--tang-muted); }
  .site-footer__links { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .site-footer__links a { color: var(--tang); }
  .site-footer__line {
    display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); justify-content: space-between;
    padding-block: var(--space-5);
    border-top: var(--border-hair) solid var(--line);
    font-family: var(--font-display); font-size: 14px; line-height: 1.45; font-weight: 500; font-variation-settings: "opsz" 14;
    color: var(--tang-subtle);
  }
  .site-footer__line a { color: var(--tang); }
  @media (max-width: 767px) {
    .site-footer__grid { grid-template-columns: 1fr; }
    .site-footer__band { padding-block: var(--space-7); }
    .site-footer__line { flex-direction: column; }
  }
</style>

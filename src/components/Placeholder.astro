---
// Photo slot. Until a photograph exists it renders a siv or sand panel with the mark centred at 48px.
// To use a real photo: put the file in public/images/ and set `image:` in the section's markdown frontmatter.
interface Props {
  src?: string;
  alt?: string;
  tone?: 'siv' | 'sand';
  radius?: 'm' | 'l';
  /** CSS aspect-ratio, e.g. "4 / 5". */
  ratio?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt = '', tone = 'siv', radius = 'm', ratio = '4 / 5', eager = false, class: className } = Astro.props;
---

{src ? (
  <img
    class={['photo', radius === 'l' && 'photo--l', className].filter(Boolean).join(' ')}
    src={src}
    alt={alt}
    style={`aspect-ratio: ${ratio}`}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
) : (
  <div
    class={['placeholder', tone === 'sand' && 'placeholder--sand', radius === 'l' && 'placeholder--l', className].filter(Boolean).join(' ')}
    style={`aspect-ratio: ${ratio}`}
    aria-hidden="true"
  >
    <img src="/logos/mark.svg" alt="" width="48" height="48" />
  </div>
)}
